# Server-only. Never use a VITE_ prefix for secrets.
OPENROUTER_API_KEY=
DATABASE_URL=sqlite:///./ecologic.db
ENVIRONMENT=development
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
COOKIE_SECURE=false
AI_DAILY_BUDGET=40
FIREBASE_PROJECT_ID=ozel-a14d1
# Set frontend API URL only when deploying separately.
VITE_API_URL=
# Optional Firebase login; email/password must be enabled in Firebase console.
VITE_FIREBASE_AUTH=false
# Optional preprocessed Sentinel-2 directory; no satellite credentials required for the open COG source.
# Leave blank to auto-select the verified city dataset; set a path only for an explicit override.
MONITORING_DATA_DIR=
